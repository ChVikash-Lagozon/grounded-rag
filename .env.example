# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- App ---
CARQ_ENV=dev
# Override the config directory (tests use this)
# CARQ_CONFIG_DIR=C:/dev/grounded-rag/config
# Data root and catalog location (relative paths resolve against the repo root)
DATA_ROOT=data
CATALOG_PATH=data/catalog.duckdb
# Any config key can be overridden as CARQ__SECTION__KEY, e.g.:
# CARQ__LOGGING__LEVEL=DEBUG

# --- LLM: development (OpenRouter) ---
OPENROUTER_API_KEY=your-openrouter-key

# --- LLM: production (Azure AI Foundry) ---
AZURE_AI_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com
AZURE_AI_FOUNDRY_API_KEY=your-foundry-key

# --- Storage: ADLS (Phase 2) ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
